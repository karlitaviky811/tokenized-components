{
  "name": "crdx-workspace",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build:lib": "ng build crdx-components",
    "build:demo": "ng build demo",
    "start": "ng serve demo",
    "start:network": "ng serve demo --host 0.0.0.0",
    "build": "ng build crdx-components --configuration production",
    "storybook": "ng run crdx-components:storybook",
    "build:storybook": "ng run crdx-components:build-storybook",
    "release": "npm run build && cd dist/crdx-components && npm publish"
  },
  "dependencies": {
    "@angular/animations": "~22.0.0",
    "@angular/cdk": "~22.0.0",
    "@angular/common": "~22.0.0",
    "@angular/compiler": "~22.0.0",
    "@angular/core": "~22.0.0",
    "@angular/forms": "~22.0.0",
    "@angular/material": "~22.0.0",
    "@angular/platform-browser": "~22.0.0",
    "@angular/platform-browser-dynamic": "~22.0.0",
    "@angular/router": "~22.0.0",
    "@ngx-translate/core": "~17.0.0",
    "ngx-mask": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/compiler-cli": "~22.0.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/angular-vite": "^10.6.6",
    "ng-packagr": "~22.0.0",
    "playwright": "^1.61.0",
    "storybook": "^10.6.6",
    "typescript": "~6.0.0",
    "vite": "^8.3.6"
  }
}
